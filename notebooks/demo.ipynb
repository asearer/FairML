# FairML Demo Notebook
import pandas as pd
from src.models.example_model import train_example_model, load_model
from src.fairness_tests.fairness import demographic_parity_difference
from src.fairness_tests.bias import introduce_bias

# Train/load model
train_example_model()
model = load_model()

# Load data
data = pd.read_csv('src/data/synthetic_data.csv')
biased_data = introduce_bias(data, 'feature_0', bias_level=0.1)

dp_diff = demographic_parity_difference(model, biased_data.drop('target', axis=1),
                                        biased_data['target'], 'feature_0')
print("Demographic Parity Difference:", dp_diff)
